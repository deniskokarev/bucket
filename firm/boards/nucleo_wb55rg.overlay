/*
 * nucleo_wb55rg overlay for the bucket project.
 *
 * Two jobs:
 *   1. Instantiate the STM32WB55 TSC peripheral. Unlike the F0/U0 SoCs, the
 *      WB `.dtsi` does NOT ship a `tsc` node, so we add it here. Register
 *      address / IRQ / clock / reset come from the STM32WB55 reference manual
 *      and CMSIS headers:
 *        TSC @ 0x40024000, IRQ 39, RCC AHB1 bit 16 (TSCEN/TSCRST).
 *   2. Declare the `pump` GPIO output.
 *   3. Board UI: SW1 as a morse button (codes below) and LED1 (blue, PB5)
 *      as the signal LED. PB5 has no timer PWM output on the WB55, so the
 *      signal-led driver uses software PWM on the GPIO.
 *
 * TSC pin choice: Group 3, on the ARDUINO headers (UM2819 Table 9), with no
 * other board function on either pin:
 *   - PC10 = G3_IO2 = D4 (CN9-5) -> sampling capacitor (external Cs to GND)
 *   - PC12 = G3_IO4 = D8 (CN5-1) -> sensing electrode (via series Rs)
 * G3_IO1 (PA15/D5) is avoided: the board DTS binds it to pwm2. Group 1
 * (PB12-15) is morpho-only and PB12 is the board's LPUART1 RTS.
 * Keep sampling-io and channel-ios in the same group.
 */

#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/input/stm32-tsc-defines.h>

/ {
	aliases {
		pump = &pump_out;
	};

	/* Simple GPIO output for the pump MOSFET/relay driver. */
	pump_control {
		compatible = "gpio-leds";
		pump_out: pump_out {
			gpios = <&gpioa 0 GPIO_ACTIVE_HIGH>;
			label = "Evacuation pump";
		};
	};

	/* SW1 (gpio-keys INPUT_KEY_0) decoded as morse codes. No `input`
	 * phandle: listen to any device so `input report` can inject presses
	 * from the shell (e2e). */
	sw1_morse: sw1-morse {
		compatible = "dkv,morse-button";
		input-code = <INPUT_KEY_0>;
		long-press-ms = <2000>;
		reset-delay-ms = <1500>;

		morse_status: status {
			code = ".";
			label = "show status";
		};
		morse_rebond: rebond {
			code = "..-";
			label = "clear bonds and pair";
		};
	};

	status_led: status-led {
		compatible = "dkv,signal-led";
		gpios = <&gpiob 5 GPIO_ACTIVE_HIGH>;
	};
};

/* The WB `soc` node is unlabeled; extend it by path to add the TSC. */
&{/soc} {
	tsc: tsc@40024000 {
		compatible = "st,stm32-tsc";
		reg = <0x40024000 0x400>;
		clocks = <&rcc STM32_CLOCK(AHB1, 16)>;
		resets = <&rctl STM32_RESET(AHB1, 16)>;
		interrupts = <39 0>;
		interrupt-names = "global";

		pinctrl-0 = <&tsc_g3_io2_pc10 &tsc_g3_io4_pc12>;
		pinctrl-names = "default";

		st,pulse-generator-prescaler = <2>;
		st,charge-transfer-pulse-high = <2>;
		st,charge-transfer-pulse-low = <2>;
		st,spread-spectrum-prescaler = <1>;
		st,spread-spectrum-deviation = <1>;
		st,max-count-value = <16383>;

		status = "okay";

		tsc_group3: group3 {
			/* Hardware TSC Group 3. The driver indexes registers as
			 * (group - 1), so Group 3 is `group = <3>`. */
			group = <3>;
			channel-ios = <TSC_IO4>;  /* PC12 / D8 electrode */
			sampling-io = <TSC_IO2>;  /* PC10 / D4 + external Cs */
			/* No `tsc-keys` child: we read the raw acquisition count
			 * ourselves (see src/tsc.c) for level sensing + validation. */
		};
	};
};
