# Source this file to start working on the firmware:  source ./zephyr.env
#
# Zephyr tree, SDK and Python venv all live under $HOME (not vendored here).
export ZEPHYR_BASE=$HOME/zephyrproject/zephyr
export ZEPHYR_SDK_INSTALL_DIR=$HOME/zephyr-sdk
export ZEPHYR_TOOLCHAIN_VARIANT=zephyr

# Activate the venv that holds `west` and Zephyr's Python requirements.
source $HOME/venv/bin/activate

# Convenience aliases (match the sibling thermo/geiger projects)
alias b="west build"
alias f="west flash"
